# Text files are LF in the work tree on every OS (the shell scripts and the Dockerfiles run in Linux containers).
* text=auto eol=lf

# Binary files: no line-ending conversion, no text diff or merge.
*.png binary
*.ico binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.avif binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.pdf binary
*.zip binary
*.gz binary
