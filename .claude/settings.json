{
  "permissions": {
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(!.env.example)",
      "Read(!backend/src/*/.env.development)",
      "Read(!backend/src/*/.env.testing)",
      "Read(!backend/src/*/.env.staging)",
      "Read(!backend/src/*/.env.production)",
      "Read(!frontend/.env.op.development)",
      "Read(!admin/.env.op.development)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*.pfx)",
      "Read(**/*.p12)",
      "Read(**/secrets/**)",
      "Read(**/appsettings.*.local.json)",
      "Edit(.env)",
      "Edit(.env.*)",
      "Edit(!.env.example)",
      "Edit(!backend/src/*/.env.development)",
      "Edit(!backend/src/*/.env.testing)",
      "Edit(!backend/src/*/.env.staging)",
      "Edit(!backend/src/*/.env.production)",
      "Edit(**/*.pem)",
      "Edit(**/*.key)",
      "Edit(**/*.pfx)",
      "Edit(**/*.p12)",
      "Edit(**/secrets/**)",
      "Edit(**/appsettings.*.local.json)",
      "Read(**/dist/**)",
      "Read(**/dev-dist/**)",
      "Read(**/coverage/**)",
      "Read(**/bin/**)",
      "Read(**/obj/**)",
      "Read(**/.eslintcache)",
      "Read(**/*.tsbuildinfo)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)/.claude/hooks/backend-migration-guard.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)/.claude/hooks/prettier-write.sh\""
          },
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)/.claude/hooks/backend-unused-usings.sh\"",
            "timeout": 120
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)/.claude/hooks/backend-build-check.sh\"",
            "timeout": 300
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "playwright@anthropic-plugin-directory": true,
    "github@anthropic-plugin-directory": false
  },
  "enabledMcpjsonServers": ["postgres", "grafana", "github"]
}
