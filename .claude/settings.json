{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/prettier-write.sh"
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/backend-unused-usings.sh",
            "timeout": 120
          }
        ]
      }
    ]
  },
  "permissions": {
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(!.env.example)",
      "Read(!backend/src/*/.env.development)",
      "Read(!backend/src/*/.env.testing)",
      "Read(!backend/src/*/.env.staging)",
      "Read(!backend/src/*/.env.production)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*.pfx)",
      "Read(**/*.p12)",
      "Read(**/secrets/**)",
      "Read(**/appsettings.*.local.json)",
      "Edit(.env)",
      "Edit(.env.*)",
      "Edit(!.env.example)",
      "Edit(!backend/src/*/.env.development)",
      "Edit(!backend/src/*/.env.testing)",
      "Edit(!backend/src/*/.env.staging)",
      "Edit(!backend/src/*/.env.production)",
      "Edit(**/*.pem)",
      "Edit(**/*.key)",
      "Edit(**/*.pfx)",
      "Edit(**/*.p12)",
      "Edit(**/secrets/**)",
      "Edit(**/appsettings.*.local.json)",
      "Read(**/dist/**)",
      "Read(**/dev-dist/**)",
      "Read(**/coverage/**)",
      "Read(**/bin/**)",
      "Read(**/obj/**)",
      "Read(**/.eslintcache)",
      "Read(**/*.tsbuildinfo)"
    ]
  }
}
