# Postgres MCP server, Development environment. Committed: holds only 1Password secret references
# (op://), never values. postgres.sh passes this file to op run. The read-only `reader` role
# (deploy/docs/postgres.md) is the only login this server uses.
PGMCP_HOST="op://Watt Wise Development/postgres-reader/server"
PGMCP_PORT="op://Watt Wise Development/postgres-reader/port"
PGMCP_DB="op://Watt Wise Development/postgres-reader/database"
PGMCP_USER="op://Watt Wise Development/postgres-reader/username"
PGMCP_PASSWORD="op://Watt Wise Development/postgres-reader/password"
