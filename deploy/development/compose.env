# 1Password secret references for the Development compose stack: every container's settings that
# are secret or that the apps read from the vault. Contains only op:// references, never values.
# Each service gets only its own names, through its `environment:` in the compose file; `mise run
# db-init` reads the role passwords from the environment op run sets and pipes them to db-init.sh's
# stdin. Every `up` and `watch` goes through op run (`ps`, `logs`, `exec`, `stop` and `down` need none):
#
#   op run --env-file deploy/development/compose.env -- \
#     docker compose -f deploy/docker-compose.development.yml up -d --wait
#
# The non-secret settings (bind addresses, ports) come from deploy/.env (see compose.settings.tpl).
# The browser URLs below are the same `url` fields deploy/.env renders for its port derivation;
# the value from op run wins, and a deployed compose.env needs no deploy/.env for them.
# Vault: "Watt Wise Development". See deploy/docs/development-stack.md.

# postgres and db-init: postgres reads it only when the data volume is empty (initdb); db-init
# connects as admin with it.
POSTGRES_PASSWORD="op://Watt Wise Development/postgres-admin/password"

# db-init only: the Cli role's password. The Cli runs on the host with its own .env.development.
CLI_DATABASE_PASSWORD="op://Watt Wise Development/postgres-cli/password"

# api (its password also goes to db-init)
API_DATABASE_NAME="op://Watt Wise Development/postgres-api/database"
API_DATABASE_USERNAME="op://Watt Wise Development/postgres-api/username"
API_DATABASE_PASSWORD="op://Watt Wise Development/postgres-api/password"
API_JWT_SIGNING_KEY="op://Watt Wise Development/jwt/password"

# jobs (its password also goes to db-init)
JOBS_DATABASE_NAME="op://Watt Wise Development/postgres-jobs/database"
JOBS_DATABASE_USERNAME="op://Watt Wise Development/postgres-jobs/username"
JOBS_DATABASE_PASSWORD="op://Watt Wise Development/postgres-jobs/password"
JOBS_SMTP_USERNAME="op://Watt Wise Development/smtp-jobs/username"
JOBS_SMTP_PASSWORD="op://Watt Wise Development/smtp-jobs/password"

# db-init only: the roles no app container uses
BACKUP_DATABASE_PASSWORD="op://Watt Wise Development/postgres-backup/password"
READER_DATABASE_PASSWORD="op://Watt Wise Development/postgres-reader/password"

# Browser URLs: the Api's own address for the web apps, and the origins the Api allows (CORS), the
# Jobs host links to and the admin's forgot-password link points at.
API_URL="op://Watt Wise Development/api/url"
FRONTEND_URL="op://Watt Wise Development/frontend/url"
ADMIN_URL="op://Watt Wise Development/admin/url"
