# 1Password secret references for the first start of the Development compose stack.
# Contains only op:// references, never values. The images read these passwords only
# to initialize empty volumes, so only that first up needs op run:
#
#   op run --env-file deploy/development/compose.env -- \
#     docker compose -f deploy/docker-compose.development.yml up -d --wait
#
# The non-secret settings come from deploy/.env (see compose.settings.tpl).
# Vault: "Watt Wise Development", items postgres-admin and pgadmin. Application
# passwords are never here; see deploy/docs/postgres.md.
POSTGRES_PASSWORD="op://Watt Wise Development/postgres-admin/password"
PGADMIN_DEFAULT_PASSWORD="op://Watt Wise Development/pgadmin/password"
