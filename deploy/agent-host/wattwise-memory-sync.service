# systemd user unit: one two-way memory sync with tethys (see sync-memory.sh).
#
# Install on vidar (nothing here enables it; do these yourself when ready):
#   mkdir -p ~/.config/systemd/user
#   cp deploy/agent-host/wattwise-memory-sync.{service,timer} ~/.config/systemd/user/
#   # Edit ExecStart below if the repo is not at the path shown.
#   systemctl --user daemon-reload
#   systemctl --user enable --now wattwise-memory-sync.timer
# Check:   systemctl --user list-timers wattwise-memory-sync.timer
# Run now: systemctl --user start wattwise-memory-sync.service
# Remove:  systemctl --user disable --now wattwise-memory-sync.timer
[Unit]
Description=Sync Watt-Wise Claude memory with tethys (unison)
Documentation=file://%h/code/personal/watt-wise/deploy/docs/agent-host.md

[Service]
Type=oneshot
ExecStart=%h/code/personal/watt-wise/deploy/agent-host/sync-memory.sh
