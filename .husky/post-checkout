# shellcheck shell=sh
# After a branch switch (not a file checkout, not the same commit), rebuild the Development stack if it runs from this checkout.
[ "${3-}" = 1 ] && [ "${1-}" != "${2-}" ] || exit 0
[ -f tools/follow-stack.ts ] || exit 0
command -v node >/dev/null 2>&1 || exit 0
node tools/follow-stack.ts --skip-mid-rebase
