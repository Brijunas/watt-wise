# Development settings for the frontend app, read from 1Password. Only op:// references live here.
# Vite doesn't load this file itself; run the dev server through 1Password:
#   op run --env-file frontend/.env.op.development -- pnpm --filter frontend dev
# `vite preview` runs the same way, after a build.
