<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Only nuget.org is used. <clear/> keeps machine-level feeds out so restores are reproducible
       and NU1507 (central package management with multiple sources) does not fire. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
