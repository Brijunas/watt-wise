# WattWise.Jobs in Development. Only op:// references; resolve with:
#   op run --env-file backend/src/WattWise.Jobs/.env.development -- dotnet run --project backend/src/WattWise.Jobs
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS="op://Watt Wise Development/jobs/url"
Database__Host="op://Watt Wise Development/postgres-jobs/server"
Database__Port="op://Watt Wise Development/postgres-jobs/port"
Database__Name="op://Watt Wise Development/postgres-jobs/database"
Database__Username="op://Watt Wise Development/postgres-jobs/username"
Database__Password="op://Watt Wise Development/postgres-jobs/password"
Observability__OtlpEndpoint="op://Watt Wise Development/otlp/url"
