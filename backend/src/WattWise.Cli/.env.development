# WattWise.Cli, Development environment. Committed: holds only 1Password secret references
# (op://), never values. op run resolves them at start; the file picks the vault.
#
#   op run --env-file backend/src/WattWise.Cli/.env.development -- dotnet run --project backend/src/WattWise.Cli -- migrate
#
# Other environments get .env.testing, .env.staging, .env.production (E5).
DOTNET_ENVIRONMENT=Development
Database__Host="op://Watt Wise Development/postgres-cli/server"
Database__Port="op://Watt Wise Development/postgres-cli/port"
Database__Name="op://Watt Wise Development/postgres-cli/database"
Database__Username="op://Watt Wise Development/postgres-cli/username"
Database__Password="op://Watt Wise Development/postgres-cli/password"
Database__Options="op://Watt Wise Development/postgres-cli/options"
Observability__OtlpEndpoint="op://Watt Wise Development/otlp/url"
