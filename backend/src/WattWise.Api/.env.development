# WattWise.Api, Development environment. Committed: holds only 1Password secret references
# (op://), never values. op run resolves them at start; the file picks the vault.
#
#   op run --env-file backend/src/WattWise.Api/.env.development -- dotnet run --project backend/src/WattWise.Api
#
# Other environments get .env.testing, .env.staging, .env.production (E5).
ASPNETCORE_ENVIRONMENT=Development
Database__Host="op://Watt Wise Development/postgres-api/server"
Database__Port="op://Watt Wise Development/postgres-api/port"
Database__Name="op://Watt Wise Development/postgres-api/database"
Database__Username="op://Watt Wise Development/postgres-api/username"
Database__Password="op://Watt Wise Development/postgres-api/password"
ASPNETCORE_URLS="op://Watt Wise Development/api/url"
