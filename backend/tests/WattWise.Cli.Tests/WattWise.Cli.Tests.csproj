<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="xunit.runner.json" CopyToOutputDirectory="IfDifferent" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3.mtp-v2" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>CliOutputDirectory</_Parameter1>
      <_Parameter2>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/../../src/WattWise.Cli/bin/$(Configuration)/$(TargetFramework)/'))</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="WattWise.Testing" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WattWise.Testing\WattWise.Testing.csproj" />
    <!-- Referenced as a whole, so it is built first; the process tests start it from its own output folder (see CliRun), where its dependencies sit. -->
    <ProjectReference Include="..\..\src\WattWise.Cli\WattWise.Cli.csproj" />
  </ItemGroup>

</Project>
