{
  "permissions": {
    "allow": [
      "Bash(gh pr merge:*)",
      "Bash(op read \"op://Watt Wise Development/smoke-accounts/*\")"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(!.env.example)",
      "Read(!.env.op.development)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*.pfx)",
      "Read(**/*.p12)",
      "Read(**/secrets/**)",
      "Edit(.env)",
      "Edit(.env.*)",
      "Edit(!.env.example)",
      "Edit(**/*.pem)",
      "Edit(**/*.key)",
      "Edit(**/*.pfx)",
      "Edit(**/*.p12)",
      "Edit(**/secrets/**)",
      "Read(**/dist/**)",
      "Read(**/dev-dist/**)",
      "Read(**/coverage/**)",
      "Read(**/.eslintcache)",
      "Read(**/*.tsbuildinfo)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)/.claude/hooks/backend-migration-guard.sh\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)/.claude/hooks/frontend-generated-guard.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)/.claude/hooks/prettier-write.sh\""
          },
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)/.claude/hooks/frontend-lint.sh\"",
            "timeout": 120
          },
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)/.claude/hooks/backend-unused-usings.sh\"",
            "timeout": 120
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)/.claude/hooks/backend-build-check.sh\"",
            "timeout": 300
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "playwright@anthropic-plugin-directory": true,
    "github@anthropic-plugin-directory": false
  },
  "enabledMcpjsonServers": ["grafana", "github"],
  "disabledMcpjsonServers": ["postgres"]
}
