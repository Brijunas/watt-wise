# Development settings for the admin app, read from 1Password. Only op:// references live here.
# Vite doesn't load this file itself; run the dev server through 1Password:
#   op run --env-file admin/.env.op.development -- pnpm --filter admin dev
# `vite preview` runs the same way, after a build.
